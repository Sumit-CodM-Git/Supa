  "trigger": "CREATE OR REPLACE FUNCTION public.prevent_duplicate_primary()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n    v_existing_user_id UUID;\nBEGIN\n    -- Only check if this row is being set to primary\n    IF NEW.user_ownership_type = 'primary'\n       AND NEW.unit_flat_number IS NOT NULL THEN\n\n        -- Look for another primary on the same flat\n        SELECT user_id INTO v_existing_user_id\n        FROM \"SSP_Society_User\"\n        WHERE society = NEW.society\n          AND COALESCE(tower::text, '\u2205') = COALESCE(NEW.tower::text, '\u2205')\n          AND COALESCE(block::text, '\u2205') = COALESCE(NEW.block::text, '\u2205')\n          AND upper(trim(unit_flat_number)) = upper(trim(NEW.unit_flat_number))\n          AND user_ownership_type = 'primary'\n          AND user_id != COALESCE(NEW.user_id, '00000000-0000-0000-0000-000000000000'::uuid)\n        LIMIT 1;\n\n        IF v_existing_user_id IS NOT NULL THEN\n            RAISE EXCEPTION\n                'Flat % already has a primary owner (user_id: %). Demote them first.',\n                NEW.unit_flat_number, v_existing_user_id\n                USING ERRCODE = '23505';\n        END IF;\n    END IF;\n\n    RETURN NEW;\nEND;\n$function$\n"
}