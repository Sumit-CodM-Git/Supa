{
  "info": {
    "name": "SSP \u2014 Non-Premium Visitor Optional Phone",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Live guard creation tests. Requires a valid security login token and resident IDs. Successful requests create test visitors; remove test records after running. Select a non-Premium resident without active devices to avoid pushes."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://isrqhkshygauaehwfycw.supabase.co/functions/v1"
    },
    {
      "key": "testPrefix",
      "value": "POSTMAN_OPTIONAL_PHONE_TEST"
    }
  ],
  "item": [
    {
      "name": "visitor-pass-operations / non-Premium / phone omitted",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actionType\": \"REQUEST_APPROVAL\",\n  \"societyRegistrationNumber\": \"{{registration}}\",\n  \"societyUserId\": \"{{nonPremiumResidentId}}\",\n  \"securityGuardId\": \"{{guardId}}\",\n  \"visitorName\": \"{{testPrefix}}_visitor-pass-operations_omitted\",\n  \"role\": \"visitor\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/visitor-pass-operations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200: non-Premium visitor created without OTP\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Created visitor ID returned\", () => { pm.expect(body.success).to.eql(true); pm.expect(body.data.visitorId).to.be.a(\"string\"); });",
              "pm.test(\"Visitor phone reflects optional input\", () => pm.expect(body.data.visitor.phone).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
